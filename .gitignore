# Windows 缓存工具按 cwd 展开 %SystemDrive% 留下的垃圾目录，不要进版本库
%SystemDrive%/

# 大脑代理的组合缓存（运行时产物，不进仓库）
.cura-cache/

# 通话引擎（engine/）：配置含 QQ 号与密钥，运行时产物不进仓库
engine/config.json
engine/__pycache__/
engine/debug-run-napcat.mjs
# .scratch 是探索性探针脚本的堆放地，只保留维护中的测试与配置样例
engine/.scratch/*
!engine/.scratch/t_session.py
!engine/.scratch/t_reply.py
!engine/.scratch/t_drain.py
!engine/.scratch/t_threshold.py
!engine/.scratch/t_polling.py
!engine/.scratch/t_cal.py

# 出行页写入的高德 key（本机私有，绝不入库/入包）
travel.json

# gh CLI 本地状态（含设备标识），不入库
.local/

# 瑞幸页写入的 token（本机私有，绝不入库/入包）
luckin.json

# 覆盖率产物（审计时临时生成，不进仓库）
cov-tmp/
