    "./rules-remote": "./lib/rules-remote.js",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": ">=3.0.0 <4.0.0",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.6 <0.3.0",
