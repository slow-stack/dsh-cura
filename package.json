  "license": "MIT",
  "author": "modusensus <guanqishi26@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slow-stack/dsh-cura.git"
  },
  "homepage": "https://github.com/slow-stack/dsh-cura#readme",
  "bugs": {
    "url": "https://github.com/slow-stack/dsh-cura/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "care",
    "health",
    "qq",
    "onebot",
    "napcat",
    "tts",
    "asr",
    "persona"
  ],
  "engines": {
    "node": ">=20"
  },
  "files": [
    "lib/",
    "engine/engine.py",
    "engine/config.example.json",
    "engine/requirements.txt",
    "engine/README.md",
    "say.ps1",
    "play-audio.py",
    "stt-whisper.py",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "exports": {
    ".": {
      "default": "./lib/index.js"
